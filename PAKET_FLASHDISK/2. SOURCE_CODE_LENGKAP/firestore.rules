rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Helper: Verifikasi Owner (Pemilik Utama / Super Admin) ──
    function isOwner() {
      return request.auth != null && request.auth.uid == 'K2ijSERTT2dg27yYGTEgn6XHSnW2';
    }

    // ─── Helper: Verifikasi Staf Terdaftar di Firestore ────
    function getStaffData() {
      return get(/databases/$(database)/documents/freshmart/cms_data/cashier_accounts/$(request.auth.uid)).data;
    }

    function isStaffActive() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/freshmart/cms_data/cashier_accounts/$(request.auth.uid)) &&
        getStaffData().isActive == true;
    }

    // ─── Helper: Verifikasi Admin Toko ─────────────────────
    function isAdmin() {
      return isOwner() || (isStaffActive() && (getStaffData().role == 'admin' || getStaffData().role == 'owner'));
    }

    // ─── Helper: Verifikasi Kasir Terdaftar ────────────────
    function isCashier() {
      return isStaffActive() && (getStaffData().role == 'cashier' || !('role' in getStaffData()));
    }
    
    // Dokumen utama toko (pengaturan, banner, kategori, dll di 'cms_data')
    match /freshmart/{docId} {
      allow read: if true;
      // Owner dan Admin memiliki akses kelola toko. Pelanggan saat checkout hanya diizinkan
      // memperbarui penanda sinkronisasi: lastUpdate, updateType, updatedProductIds, hasCashier
      allow write: if isOwner() || isAdmin() ||
        (resource != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUpdate', 'updateType', 'updatedProductIds', 'hasCashier']));

      // Sub-koleksi Produk
      match /products/{productId} {
        allow read: if true;
        // Owner & Admin boleh tambah, edit, hapus seluruh produk & varian.
        // Pelanggan saat checkout HANYA boleh mengubah stock, isActive, variants, totalSold.
        // Kasir POS juga bisa update stok saat transaksi.
        allow write: if isAdmin() || isCashier() || (
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'isActive', 'variants', 'totalSold']) &&
          (
            !('stock' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.stock <= resource.data.stock
          )
        );
      }

      // ─── Akun Staf & Kasir (PRIVATE: hanya Owner yang bisa buat/edit/hapus) ─
      match /cashier_accounts/{cashierId} {
        // Owner atau staf yang bersangkutan bisa membaca data profilnya
        allow get: if isOwner() || (request.auth != null && request.auth.uid == cashierId);
        allow list: if isOwner() || isAdmin();
        // HANYA Owner yang bisa mendaftarkan, mengubah hak akses, atau menghapus staf
        allow create, update, delete: if isOwner();
      }

      // Database Pelanggan / Member (data profil, poin & limit paylater)
      // Publik & Kasir dapat membaca data member untuk lookup profil & poin saat transaksi POS.
      match /customers/{phone} {
        allow read: if true;
        allow create: if isAdmin() || isCashier();
        allow update: if isAdmin() || isCashier() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'lastOrderAt', 'paylaterUsed', 'name']);
        allow delete: if isAdmin();
      }

      // Program Hadiah / Rewards (katalog publik, stok berkurang saat klaim)
      match /rewards/{rewardId} {
        allow read: if true;
        allow write: if isAdmin() || (
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock <= resource.data.stock
        );
      }

      // Ulasan Produk (publik boleh membaca & mengirim ulasan baru)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }

      // Tanya Jawab / FAQ (publik boleh membaca & mengajukan pertanyaan baru)
      match /faqs/{faqId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }

      // Sesi Admin Tunggal (Single Active Session / Kick-out Otomatis Antar Perangkat Owner)
      match /admin_session/{sessionId} {
        allow read: if true;
        allow write: if isOwner();
      }

      // ─── Transaksi Kasir POS ───────────────────────────────
      // Terbuka untuk read & create agar kasir POS, admin, dan storefront
      // dapat membaca riwayat kasir dan mencatat transaksi tanpa terhambat sesi.
      match /pos_transactions/{txId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
      }

      // ─── Shift Kasir POS (Buka/Tutup Kasir, Rekonsiliasi & Settlement) ──
      match /pos_shifts/{shiftId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
      }

      // Pesanan Tempo POS (kompatibilitas modul Piutang Tempo)
      match /orders/{orderId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
      }
    }

    // Shift Kasir POS (Koleksi Root Fallback)
    match /pos_shifts/{shiftId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
    }

    // Pesanan Toko Terpadu (Storefront, Kasir POS & CMS Admin)
    match /freshmart_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
    }

    // Lisensi PRO (Hanya Owner)
    match /freshmart_licenses/{licenseId} {
      allow read, write: if isOwner();
    }
  }
}
