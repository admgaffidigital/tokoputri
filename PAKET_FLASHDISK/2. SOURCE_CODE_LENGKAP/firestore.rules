rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Helper: Verifikasi Admin Toko ─────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'K2ijSERTT2dg27yYGTEgn6XHSnW2';
    }

    // ─── Helper: Verifikasi Kasir Terdaftar ────────────────
    // Kasir adalah akun Firebase Auth yang UID-nya terdaftar di
    // freshmart/cms_data/cashier_accounts dengan role == 'cashier' & isActive == true
    function isCashier() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/freshmart/cms_data/cashier_accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/freshmart/cms_data/cashier_accounts/$(request.auth.uid)).data.role == 'cashier' &&
        get(/databases/$(database)/documents/freshmart/cms_data/cashier_accounts/$(request.auth.uid)).data.isActive == true;
    }
    
    // Dokumen utama toko (pengaturan, banner, kategori, dll di 'cms_data')
    match /freshmart/{docId} {
      allow read: if true;
      // Admin memiliki akses penuh. Pelanggan saat checkout hanya diizinkan
      // memperbarui penanda sinkronisasi: lastUpdate, updateType, updatedProductIds
      allow write: if isAdmin() ||
        (resource != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUpdate', 'updateType', 'updatedProductIds']));

      // Sub-koleksi Produk
      match /products/{productId} {
        allow read: if true;
        // Admin boleh tambah, edit, hapus seluruh produk & varian.
        // Pelanggan saat checkout HANYA boleh mengubah stock, isActive, variants, totalSold.
        // Kasir POS juga bisa update stok saat transaksi.
        allow write: if isAdmin() || isCashier() || (
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'isActive', 'variants', 'totalSold']) &&
          (
            !('stock' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.stock <= resource.data.stock
          )
        );
      }

      // ─── Akun Kasir (PRIVATE: hanya admin yang bisa buat/edit) ─
      match /cashier_accounts/{cashierId} {
        // Admin bisa baca semua. Kasir hanya bisa baca data miliknya sendiri.
        allow get: if isAdmin() || (request.auth != null && request.auth.uid == cashierId);
        allow list: if isAdmin();
        // Hanya admin yang bisa mendaftarkan, mengubah, atau menghapus akun kasir
        allow create, update, delete: if isAdmin();
      }

      // Database Pelanggan / Member (data profil & poin)
      // Publik & Kasir dapat membaca data member untuk lookup profil & poin saat transaksi POS.
      match /customers/{phone} {
        allow read: if true;
        allow create: if isAdmin() || isCashier();
        allow update: if isAdmin() || isCashier() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'lastOrderAt']);
        allow delete: if isAdmin();
      }

      // Program Hadiah / Rewards (katalog publik, stok berkurang saat klaim)
      match /rewards/{rewardId} {
        allow read: if true;
        allow write: if isAdmin() || (
          resource != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock <= resource.data.stock
        );
      }

      // Ulasan Produk (publik boleh membaca & mengirim ulasan baru)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }

      // Tanya Jawab / FAQ (publik boleh membaca & mengajukan pertanyaan baru)
      match /faqs/{faqId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }

      // Sesi Admin Tunggal (Single Active Session / Kick-out Otomatis Antar Perangkat)
      match /admin_session/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // ─── Transaksi Kasir POS ───────────────────────────────
      // Terbuka untuk read & create agar kasir POS, admin, dan storefront
      // dapat membaca riwayat kasir dan mencatat transaksi tanpa terhambat sesi.
      match /pos_transactions/{txId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
      }

      // ─── Shift Kasir POS (Buka/Tutup Kasir, Rekonsiliasi & Settlement) ──
      match /pos_shifts/{shiftId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
      }

      // Pesanan Tempo POS (kompatibilitas modul Piutang Tempo)
      match /orders/{orderId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
      }
    }

    // Shift Kasir POS (Koleksi Root Fallback)
    match /pos_shifts/{shiftId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
    }

    // Pesanan Toko Terpadu (Storefront, Kasir POS & CMS Admin)
    match /freshmart_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isCashier() || (request.auth != null);
    }

    // Lisensi PRO
    match /freshmart_licenses/{licenseId} {
      allow read, write: if isAdmin();
    }
  }
}
