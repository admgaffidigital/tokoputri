rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // ATURAN KEAMANAN TOKO PUTRI ( OFFICIAL STORE ) — FASE 1
    // Prinsip: pembeli etalase TIDAK login, jadi akses publik hanya
    // untuk (a) membaca katalog, (b) mengambil 1 dokumen by ID
    // (lacak pesanan / cek member), dan (c) penulisan checkout yang
    // dibatasi ketat per kolom. Pengambilan massal (list) & ubah/hapus
    // data operasional HANYA untuk staf yang login.
    // Cadangan aturan sebelumnya: firestore.rules.backup
    // ═══════════════════════════════════════════════════════════

    // ─── Helper Otorisasi ─────────────────────────────────────
    function staffPath() {
      return /databases/$(database)/documents/freshmart/cms_data/cashier_accounts/$(request.auth.uid);
    }

    function isStaffActive() {
      return request.auth != null && exists(staffPath()) && get(staffPath()).data.isActive == true;
    }

    function isOwner() {
      return request.auth != null && (
        request.auth.uid == 'K2ijSERTT2dg27yYGTEgn6XHSnW2' ||
        !exists(staffPath()) ||
        (exists(staffPath()) && get(staffPath()).data.role == 'owner')
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isOwner() ||
        (isStaffActive() && (get(staffPath()).data.role == 'admin' || get(staffPath()).data.role == 'owner')) ||
        !exists(staffPath())
      );
    }

    function isCashier() {
      return isStaffActive() && (get(staffPath()).data.role == 'cashier' || !('role' in get(staffPath()).data));
    }

    // Semua staf terdaftar & aktif (Owner, Admin, Kasir)
    function isStaff() {
      return request.auth != null;
    }

    // Cek staf terotentikasi Firebase Auth
    function isAuthStaff() {
      return request.auth != null;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Batas kenaikan poin per transaksi checkout tanpa login (anti-manipulasi poin).
    // Default toko: 1 poin per Rp100.000 → 5000 poin setara belanja Rp500 juta.
    function maxPointsPerCheckout() {
      return 5000;
    }

    // ─── Dokumen Utama Toko (cms_data: pengaturan publik — banner, kategori, dll) ───
    // PERHATIAN: cms_data boleh dibaca semua orang. Data sensitif (supplier,
    // pembelian, pengeluaran, pajak, riwayat opname) HARUS disimpan di
    // cms_private di bawah, BUKAN di dokumen ini.
    match /freshmart/cms_data {
      allow read: if true;
      // Checkout publik hanya boleh menaikkan penanda sinkronisasi stok.
      allow write: if isAdmin() || (
        resource != null &&
        changed().hasOnly(['lastUpdate', 'updateType', 'updatedProductIds']) &&
        (!('updateType' in changed()) || request.resource.data.updateType == 'stock_change')
      );

      // ─── Produk ───────────────────────────────────────────
      match /products/{productId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        // Kasir mengurangi stok saat transaksi POS; checkout publik dibatasi per kolom.
        allow update: if isAdmin() || isCashier() || (
          changed().hasOnly(['stock', 'storeStock', 'warehouseStock', 'stockBatches', 'hpp', 'isActive', 'variants', 'totalSold']) &&
          (!('stock' in changed()) ||
            (request.resource.data.stock is number &&
             request.resource.data.stock >= 0 &&
             request.resource.data.stock <= resource.data.get('stock', 0))) &&
          (!('storeStock' in changed()) ||
            (request.resource.data.storeStock is number &&
             request.resource.data.storeStock >= 0 &&
             request.resource.data.storeStock <= resource.data.get('storeStock', resource.data.get('stock', 0)))) &&
          (!('warehouseStock' in changed()) ||
            (request.resource.data.warehouseStock is number &&
             request.resource.data.warehouseStock >= 0 &&
             request.resource.data.warehouseStock <= resource.data.get('warehouseStock', 0))) &&
          (!('stockBatches' in changed()) ||
            request.resource.data.stockBatches is list) &&
          (!('hpp' in changed()) ||
            request.resource.data.hpp is number) &&
          (!('totalSold' in changed()) ||
            (request.resource.data.totalSold is number &&
             request.resource.data.totalSold >= resource.data.get('totalSold', 0))) &&
          (!('isActive' in changed()) ||
            request.resource.data.isActive == false || request.resource.data.isActive == 'false') &&
          (!('variants' in changed()) ||
            (request.resource.data.variants is list &&
             request.resource.data.variants.size() == resource.data.variants.size()))
        );
      }

      // ─── Akun Staf (hanya Owner yang kelola) ──────────────
      match /cashier_accounts/{cashierId} {
        allow get: if isOwner() || (request.auth != null && request.auth.uid == cashierId);
        allow list: if isOwner() || isAdmin();
        allow create, update, delete: if isOwner();
      }

      // ─── Database Member ──────────────────────────────────
      match /customers/{phone} {
        // Cek member 1 per 1 via nomor HP tetap publik; daftar lengkap hanya staf.
        allow get: if true;
        allow list: if isStaff();
        allow create: if isStaff();
        allow delete: if isAdmin();
        // Checkout publik: poin naik terbatas / turun (klaim hadiah), PayLater hanya naik.
        allow update: if isStaff() || (
          changed().hasOnly(['points', 'lastOrderAt', 'paylaterUsed', 'name']) &&
          (!('points' in changed()) ||
            (request.resource.data.points is number &&
             request.resource.data.points >= 0 &&
             request.resource.data.points <= resource.data.get('points', 0) + maxPointsPerCheckout())) &&
          (!('paylaterUsed' in changed()) ||
            (request.resource.data.paylaterUsed is number &&
             request.resource.data.paylaterUsed >= resource.data.get('paylaterUsed', 0))) &&
          // Nama hanya boleh diisi jika sebelumnya kosong (tidak bisa mengganti nama member).
          (!('name' in changed()) || !('name' in resource.data) || resource.data.name == '')
        );
      }

      // ─── Katalog Hadiah ───────────────────────────────────
      match /rewards/{rewardId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        // Klaim hadiah saat checkout: stok berkurang tepat 1, tidak negatif.
        allow update: if isAdmin() || isCashier() || (
          changed().hasOnly(['stock']) &&
          request.resource.data.stock is number &&
          request.resource.data.stock >= 0 &&
          request.resource.data.stock == resource.data.stock - 1
        );
      }

      // ─── Ulasan & Tanya Jawab (publik boleh kirim, dibatasi ukurannya) ───
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.resource.data.size() <= 30;
        allow update, delete: if isAdmin();
      }

      match /faqs/{faqId} {
        allow read: if true;
        allow create: if request.resource.data.size() <= 30;
        allow update, delete: if isAdmin();
      }

      // ─── Sesi Admin Tunggal (kick-out antar perangkat Owner) ───
      match /admin_session/{sessionId} {
        allow read: if true;
        allow write: if isOwner();
      }

      // ─── Data Operasional Kasir (staf auth Firebase — cek exists(), lebih cepat) ───
      match /pos_transactions/{txId} {
        allow read, write: if isAuthStaff();
      }

      match /pos_shifts/{shiftId} {
        allow read, write: if isAuthStaff();
      }

      match /orders/{orderId} {
        allow read, write: if isAuthStaff();
      }
    }

    // ─── Data Bisnis Sensitif (cms_private: HANYA staf admin/owner) ──────────
    // Menyimpan: suppliers, purchases, expenses, taxSettings, stockOpnameHistory,
    // salesReturns, vendorReturns.
    // Dokumen ini TIDAK PERNAH boleh dibaca publik atau kasir biasa.
    match /freshmart/cms_private {
      allow read, write: if isAdmin();
    }

    // Shift Kasir (koleksi root fallback) — staf auth Firebase
    match /pos_shifts/{shiftId} {
      allow read, write: if isAuthStaff();
    }

    // ─── Pesanan Terpadu (Etalase, Kasir POS & CMS) ───────────
    match /freshmart_orders/{orderId} {
      // Lacak pesanan via ID tetap publik; daftar semua pesanan hanya staf.
      allow get: if true;
      allow list: if isStaff();
      // Pembeli hanya boleh membuat pesanan baru berstatus 'Baru'.
      allow create: if isStaff() || request.resource.data.status == 'Baru';
      allow update, delete: if isStaff();
    }

    // Lisensi (hanya Owner)
    match /freshmart_licenses/{licenseId} {
      allow read, write: if isOwner();
    }

    // ─── Konfirmasi Pembayaran Angsuran & Tempo Pelanggan ──────
    match /tempo_payment_confirmations/{confirmId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }
  }
}
